// Prisma Schema for 资源管理平台
//
// 数据源：开发阶段使用 SQLite。SQLite connector 不支持 enum，因此枚举字段
// 暂用 String 存储，值由应用层（shared-types 中的常量）约束。
//
// 切换 PostgreSQL 时：
//   1. 将 provider 改为 "postgresql"
//   2. 将下方 String 类型的枚举字段改为对应的 enum 类型（ResourceType 等）
//   3. 删除旧迁移历史，重新 prisma migrate dev
//   4. 补充 @db.Text / @db.Decimal 等原生类型标注
//   5. 通过 raw migration 将 searchVector 列改为 tsvector 并建 GIN 索引
//
// 枚举值定义见 packages/shared-types/src/enums.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 模型 ====================

model Resource {
  id               String   @id @default(uuid())
  title            String
  description      String?
  originalFilename String
  // ResourceType 枚举值，见 shared-types。SQLite 阶段用 String。
  resourceType     String
  mimeType         String
  extension        String
  sizeBytes        BigInt
  sha256           String?
  categoryId       String?
  source           String?
  author           String?
  licenseNote      String?
  // 外部资源接入字段。local_upload 为已有上传资源的默认模式。
  acquisitionMode  String   @default("local_upload")
  sourceId         String?
  licenseId        String?
  licenseStatus    String   @default("unknown")
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  isFavorite       Boolean  @default(false)
  // ProcessingStatus 枚举值（pending/processing/completed/failed）
  processingStatus String   @default("pending")
  duplicateOfId    String?
  width            Int?
  height           Int?
  durationSeconds  Decimal?
  // searchVector: PostgreSQL tsvector，SQLite 阶段用 String 占位，不写入
  // 切换 PG 后通过 raw migration 改为 tsvector 类型并建 GIN 索引
  searchVector     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  // 关系
  category        Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceRecord    Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  license         License?             @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  duplicateOf     Resource?            @relation("ResourceDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates      Resource[]           @relation("ResourceDuplicates")
  files           ResourceFile[]
  tags            ResourceTag[]
  collectionItems CollectionResource[]
  processingJobs  ProcessingJob[]
  covers          Collection[]         @relation("CollectionCover")
  locators        ResourceLocator[]
  provenance      ResourceProvenance[]
  ingestionJobs   IngestionJob[]

  @@index([sha256])
  @@index([isFavorite])
  @@index([processingStatus])
  @@index([resourceType])
  @@index([categoryId])
  @@index([sourceId])
  @@index([licenseId])
  @@index([acquisitionMode])
  @@index([licenseStatus])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
  // 复合索引：几乎所有查询都过滤 deletedAt IS NULL，复合索引可同时满足筛选+排序
  @@index([deletedAt, createdAt])
  @@index([deletedAt, resourceType])
  @@index([deletedAt, categoryId])
  @@index([deletedAt, isFavorite])
  @@index([deletedAt, processingStatus])
  @@index([sizeBytes])
  @@map("resources")
}

model Source {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  baseUrl            String?
  sourceType         String
  enabled            Boolean  @default(true)
  allowedModes       String   @default("link_only,metadata_only")
  termsUrl           String?
  robotsUrl          String?
  defaultLicenseId   String?
  rateLimitPerMinute Int      @default(30)
  maxConcurrency     Int      @default(1)
  requiresReview     Boolean  @default(false)
  config             String?
  lastSyncedAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  defaultLicense License?            @relation("SourceDefaultLicense", fields: [defaultLicenseId], references: [id], onDelete: SetNull)
  resources      Resource[]
  locators       ResourceLocator[]
  provenance     ResourceProvenance[]
  ingestionJobs  IngestionJob[]

  @@index([enabled])
  @@map("sources")
}

model License {
  id                   String   @id @default(uuid())
  spdxId               String?  @unique
  name                 String
  url                  String?
  text                 String?
  allowsCommercialUse  Boolean?
  allowsRedistribution Boolean?
  allowsDerivatives    Boolean?
  requiresAttribution  Boolean  @default(false)
  shareAlike           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  resources       Resource[]
  defaultForSources Source[] @relation("SourceDefaultLicense")

  @@map("licenses")
}

model ResourceLocator {
  id             String   @id @default(uuid())
  resourceId     String
  sourceId       String?
  locatorType    String
  url            String
  canonicalUrl   String?
  identityUrl    String?  @unique
  externalId     String?
  isPrimary      Boolean  @default(false)
  httpStatus     Int?
  contentType    String?
  contentLength  BigInt?
  etag           String?
  lastModified   DateTime?
  lastCheckedAt  DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  source   Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([resourceId])
  @@index([sourceId])
  @@unique([sourceId, externalId])
  @@map("resource_locators")
}

model ResourceProvenance {
  id               String   @id @default(uuid())
  resourceId       String
  sourceId         String?
  ingestionJobId   String?
  connectorType    String
  connectorVersion String
  originalUrl      String
  publisher        String?
  authorName       String?
  authorUrl        String?
  licenseText      String?
  licenseUrl       String?
  attributionText  String?
  rawMetadata      String?
  capturedAt       DateTime @default(now())

  resource     Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  ingestionJob IngestionJob? @relation(fields: [ingestionJobId], references: [id], onDelete: SetNull)

  @@index([resourceId])
  @@index([sourceId])
  @@index([ingestionJobId])
  @@map("resource_provenance")
}

model IngestionJob {
  id             String   @id @default(uuid())
  sourceId       String?
  resourceId     String?
  jobType        String
  status         String   @default("pending")
  request        String
  result         String?
  idempotencyKey String
  retryCount     Int      @default(0)
  nextRunAt      DateTime?
  startedAt      DateTime?
  leaseToken     String?
  finishedAt     DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  source     Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  resource   Resource?            @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  provenance ResourceProvenance[]

  @@index([status, nextRunAt])
  @@index([idempotencyKey])
  @@index([sourceId])
  @@index([resourceId])
  @@map("ingestion_jobs")
}

model ResourceFile {
  id         String   @id @default(uuid())
  resourceId String
  // FileRole 枚举值（original/thumbnail/preview/extracted_text/transcode）
  fileRole   String
  variant    String   @default("")
  storagePath String
  mimeType   String
  extension  String
  sizeBytes  BigInt
  width      Int?
  height     Int?
  durationSeconds Decimal?
  createdAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fileRole, variant])
  @@index([resourceId])
  @@index([fileRole])
  @@map("resource_files")
}

model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  color     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  resources ResourceTag[]

  @@map("tags")
}

model ResourceTag {
  resourceId String
  tagId      String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@index([tagId])
  @@map("resource_tags")
}

model Category {
  id        String       @id @default(uuid())
  name      String
  parentId  String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]   @relation("CategoryTree")
  resources Resource[]

  @@unique([name, parentId])
  @@map("categories")
}

model Collection {
  id              String               @id @default(uuid())
  name            String
  description     String?
  coverResourceId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  coverResource Resource?             @relation("CollectionCover", fields: [coverResourceId], references: [id], onDelete: SetNull)
  resources     CollectionResource[]

  @@map("collections")
}

model CollectionResource {
  collectionId String
  resourceId   String
  sortOrder    Int      @default(0)
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resource   Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([collectionId, resourceId])
  @@index([collectionId])
  @@map("collection_resources")
}

model ProcessingJob {
  id           String    @id @default(uuid())
  resourceId   String
  // JobType 枚举值（detect_metadata/generate_thumbnail/...）
  jobType      String
  // JobStatus 枚举值（pending/processing/completed/failed/canceled）
  status       String    @default("pending")
  errorMessage String?
  retryCount   Int       @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([jobType])
  @@index([status])
  @@index([createdAt])
  @@map("processing_jobs")
}
