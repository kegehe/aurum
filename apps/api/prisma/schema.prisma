// Prisma Schema for Aurum
//
// 数据源：开发阶段使用 SQLite。SQLite connector 不支持 enum，因此枚举字段
// 暂用 String 存储，值由应用层（shared-types 中的常量）约束。
//
// 切换 PostgreSQL 时：
//   1. 将 provider 改为 "postgresql"
//   2. 将下方 String 类型的枚举字段改为对应的 enum 类型（ResourceType 等）
//   3. 删除旧迁移历史，重新 prisma migrate dev
//   4. 补充 @db.Text / @db.Decimal 等原生类型标注
//   5. 通过 raw migration 将 searchVector 列改为 tsvector 并建 GIN 索引
//
// 枚举值定义见 packages/shared-types/src/enums.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 模型 ====================

model Resource {
  id                String    @id @default(uuid())
  title             String
  description       String?
  originalFilename  String
  // ResourceType 枚举值，见 shared-types。SQLite 阶段用 String。
  resourceType      String
  mimeType          String
  extension         String
  sizeBytes         BigInt
  sha256            String?
  categoryId        String?
  source            String?
  author            String?
  // 外部资源接入字段。local_upload 为已有上传资源的默认模式。
  acquisitionMode   String    @default("local_upload")
  sourceId          String?
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  isFavorite        Boolean   @default(false)
  // ProcessingStatus 枚举值（pending/processing/completed/failed）
  processingStatus  String    @default("pending")
  duplicateOfId     String?
  width             Int?
  height            Int?
  durationSeconds   Decimal?
  // searchVector: PostgreSQL tsvector，SQLite 阶段用 String 占位，不写入
  // 切换 PG 后通过 raw migration 改为 tsvector 类型并建 GIN 索引
  searchVector      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // 关系
  category           Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceRecord       Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  duplicateOf        Resource?            @relation("ResourceDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates         Resource[]           @relation("ResourceDuplicates")
  files              ResourceFile[]
  processingJobs     ProcessingJob[]
  locators           ResourceLocator[]
  provenance         ResourceProvenance[]
  ingestionJobs      IngestionJob[]
  referenceSnapshots ReferenceSnapshot[]  @relation("ReferenceSnapshotResource")

  @@index([sha256])
  @@index([isFavorite])
  @@index([processingStatus])
  @@index([resourceType])
  @@index([categoryId])
  @@index([sourceId])
  @@index([acquisitionMode])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
  // 复合索引：几乎所有查询都过滤 deletedAt IS NULL，复合索引可同时满足筛选+排序
  @@index([deletedAt, createdAt])
  @@index([deletedAt, resourceType])
  @@index([deletedAt, categoryId])
  @@index([deletedAt, isFavorite])
  @@index([deletedAt, processingStatus])
  @@index([sizeBytes])
  @@map("resources")
}

model Source {
  id                    String    @id @default(uuid())
  name                  String
  slug                  String    @unique
  baseUrl               String?
  sourceType            String
  enabled               Boolean   @default(true)
  allowedModes          String    @default("link_only,metadata_only")
  termsUrl              String?
  robotsUrl             String?
  rateLimitPerMinute    Int       @default(30)
  downloadIntervalMs    Int       @default(1000)
  maxConcurrency        Int       @default(1)
  requiresReview        Boolean   @default(false)
  config                String?
  /// 定时自动同步间隔（小时）；null = 关闭，>0 = 每隔 N 小时自动拉取
  autoSyncIntervalHours Int?
  /// 下载目录（相对存储根目录的子目录，如 `civitai/foo`）；null = 默认存储布局
  downloadDirectory     String?
  /// 同步下载的资源默认归入的资源库文件夹；null = 不归档
  downloadCategoryId    String?
  lastSyncedAt          DateTime?
  lastSyncStatus        String?
  lastSyncError         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  resources     Resource[]
  locators      ResourceLocator[]
  provenance    ResourceProvenance[]
  ingestionJobs IngestionJob[]
  downloadCategory          Category?     @relation("SourceDownloadCategory", fields: [downloadCategoryId], references: [id], onDelete: SetNull)
  referenceTermsAcceptances DesignReferenceTermsAcceptance[]
  designReferenceQuota      DesignReferenceQuota?

  @@index([enabled])
  @@index([downloadCategoryId])
  @@map("sources")
}

model ResourceLocator {
  id            String    @id @default(uuid())
  resourceId    String
  sourceId      String?
  locatorType   String
  url           String
  canonicalUrl  String?
  identityUrl   String?   @unique
  externalId    String?
  isPrimary     Boolean   @default(false)
  httpStatus    Int?
  contentType   String?
  contentLength BigInt?
  etag          String?
  lastModified  DateTime?
  lastCheckedAt DateTime?
  lastError     String?
  /// 下载失败次数（成功下载后清零）；后台补漏任务据此做退避与上限
  downloadAttempts      Int       @default(0)
  /// 下次允许重试下载的时间；null 表示下一次补漏即可尝试
  nextDownloadAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  source   Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@index([resourceId])
  @@index([sourceId])
  @@index([nextDownloadAttemptAt])
  @@map("resource_locators")
}

/// 远端条目台账（tombstone）：记录「这个远端条目已经处理过」。
///
/// 为什么不复用 ResourceLocator 判重：locator 随 Resource 级联删除，用户在回收站
/// 彻底删除后判重依据就没了，下次同步会把同一条目当新资源重新下载。台账刻意不建
/// 外键，资源删除、来源删除都不影响它，从而保证「同一条目只下载一次」。
/// state=metadata_only 表示只记录了元数据（未下载文件），不阻止后续下载。
model SourceItemLedger {
  id            String   @id @default(uuid())
  /// 连接器类型（civitai / github / rss），与 ResourceLocator.identityUrl 的前缀一致
  connectorType String
  /// 远端条目 ID（Civitai image id 等），来源侧稳定不变
  externalId    String
  /// 首次记录该条目的来源，仅用于溯源与按来源清理
  sourceId      String?
  /// 最后写入该条目的资源 ID；资源可能已被彻底删除，故只存值、不建关系
  resourceId    String?
  /// downloaded | metadata_only
  state         String   @default("downloaded")
  sha256        String?
  sizeBytes     BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([connectorType, externalId])
  @@index([sha256])
  @@index([sourceId])
  @@map("source_item_ledger")
}

// AI 供应商配置（可在「设置 → AI 配置」中管理，无需改 .env 重启）
// 支持多个配置，同时仅一个生效（isActive）。未配置时回退到环境变量 ANTHROPIC_API_KEY。
model AiProvider {
  id             String          @id @default(uuid())
  // 配置名称，如 "官方" / "中转代理"
  name           String
  // 供应商类型（当前仅支持 anthropic 兼容接口）
  provider       String          @default("anthropic")
  // 自定义接口地址（留空使用官方默认）。SDK 会在其后追加 /v1/messages
  baseUrl        String?
  // 密钥。落库为明文（本地自托管），对外只返回掩码
  apiKey         String
  // 使用的模型名，如 claude-sonnet-5
  model          String          @default("claude-sonnet-5")
  // 是否当前生效（同时仅一条为 true）
  isActive       Boolean         @default(false)
  // 是否启用；停用的配置不可生效，生效中停用会回退到下一个可用配置/环境变量
  enabled        Boolean         @default(true)
  // 最近一次连通性测试结果
  lastTestedAt   DateTime?
  lastTestStatus String?
  lastTestError  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  changeSessions ChangeSession[] @relation("ChangeSessionProvider")

  @@index([isActive, enabled])
  @@map("ai_providers")
}

/// AI 用量明细：每发起一次上游模型请求记录一行（成功与失败都记）。
///
/// 刻意不建 AiProvider 外键：供应商配置可能被删除/重建，历史用量仍需保留；
/// providerId / providerName 只是调用当时的快照。
/// 失败请求通常拿不到 usage，token 字段为 0，仅计入请求次数与成功率。
model AiUsageLog {
  id                  String   @id @default(uuid())
  /// 供应商类型（anthropic）
  provider            String
  /// 调用时的 AiProvider.id；环境变量回退时为 null
  providerId          String?
  /// 配置名称快照（环境变量回退时为「环境变量」）
  providerName        String?
  /// 实际模型名（优先取响应里的 model）
  model               String
  /// 调用来源：style.analyze / style.variations / design.generate / design.repair
  feature             String
  /// success | error
  status              String
  /// 失败分类：connectivity / rate_limit / auth / output / capability / canceled / unknown
  errorKind           String?
  /// 失败摘要（截断），便于排查
  errorMessage        String?
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  /// 命中缓存的输入 tokens（Anthropic prompt caching）
  cacheReadTokens     Int      @default(0)
  /// 写入缓存的输入 tokens
  cacheCreationTokens Int      @default(0)
  /// 上游请求耗时（毫秒）
  latencyMs           Int
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([model, createdAt])
  @@map("ai_usage_logs")
}

model ResourceProvenance {
  id               String   @id @default(uuid())
  resourceId       String
  sourceId         String?
  ingestionJobId   String?
  connectorType    String
  connectorVersion String
  originalUrl      String
  publisher        String?
  authorName       String?
  authorUrl        String?
  attributionText  String?
  rawMetadata      String?
  capturedAt       DateTime @default(now())

  resource     Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  ingestionJob IngestionJob? @relation(fields: [ingestionJobId], references: [id], onDelete: SetNull)

  @@index([resourceId])
  @@index([sourceId])
  @@index([ingestionJobId])
  @@map("resource_provenance")
}

model IngestionJob {
  id             String    @id @default(uuid())
  sourceId       String?
  resourceId     String?
  jobType        String
  status         String    @default("pending")
  request        String
  result         String?
  idempotencyKey String
  retryCount     Int       @default(0)
  nextRunAt      DateTime?
  startedAt      DateTime?
  leaseToken     String?
  finishedAt     DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  source     Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  resource   Resource?            @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  provenance ResourceProvenance[]

  @@index([status, nextRunAt])
  @@index([idempotencyKey])
  @@index([sourceId])
  @@index([resourceId])
  @@map("ingestion_jobs")
}

model ResourceFile {
  id              String   @id @default(uuid())
  resourceId      String
  // FileRole 枚举值（original/thumbnail/preview/extracted_text/transcode/snapshot）
  fileRole        String
  variant         String   @default("")
  storagePath     String
  mimeType        String
  extension       String
  sizeBytes       BigInt
  width           Int?
  height          Int?
  durationSeconds Decimal?
  createdAt       DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fileRole, variant])
  @@index([resourceId])
  @@index([fileRole])
  // 删除/清空回收站前要按 storagePath 反查引用，一致性检查按 storagePath 排序
  // 全表读取，仪表盘存储统计按 storagePath 分组求和。带上 resourceId/sizeBytes
  // 让三条查询都走覆盖索引：单列索引会让分组求和改成沿索引随机回表，实测反而
  // 慢 3 倍；两列版仍缺 sizeBytes，回表后约慢 2 倍。三列只比两列多占 0.13MB。
  @@index([storagePath, resourceId, sizeBytes])
  @@map("resource_files")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  resources Resource[]
  downloadSources Source[] @relation("SourceDownloadCategory")

  @@unique([name, parentId])
  @@map("categories")
}

model ProcessingJob {
  id           String    @id @default(uuid())
  resourceId   String
  // JobType 枚举值（detect_metadata/generate_thumbnail/...）
  jobType      String
  // JobStatus 枚举值（pending/processing/completed/failed/canceled）
  status       String    @default("pending")
  errorMessage String?
  retryCount   Int       @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([jobType])
  @@index([status])
  @@index([createdAt])
  @@map("processing_jobs")
}

// ==================== AI 原生设计运营 ====================

model DesignDocument {
  id                        String   @id @default(uuid())
  slug                      String   @unique
  name                      String
  kind                      String
  format                    String   @default("token") // token | package | legacy
  subtype                   String?
  description               String?
  whenToUse                 String?
  source                    String   @default("manual") // manual | ai | reference | recipe | import
  favorite                  Boolean  @default(false)
  status                    String   @default("draft")
  visibility                String   @default("internal")
  currentPublishedVersionId String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  versions                DesignVersion[]    @relation("DesignDocumentVersions")
  currentPublishedVersion DesignVersion?     @relation("DesignDocumentCurrentVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)
  dependenciesFrom        DesignDependency[] @relation("DependencyFrom")
  dependenciesTo          DesignDependency[] @relation("DependencyTo")
  drafts                  DesignDraft[]
  tags                    DesignAssetTagLink[]
  changeSetItems          ChangeSetItem[]
  accessLogs              DesignAccessLog[]

  studioSessions           ChangeSession[]    @relation("DesignStudioSessions")

  @@index([kind, status])
  @@index([currentPublishedVersionId])
  @@map("design_documents")
}

model DesignVersion {
  id                    String    @id @default(uuid())
  documentId            String
  versionNumber         Int
  format                String    @default("token") // token | package | legacy
  baseVersionId         String?
  content               String
  contentHash           String
  summary               String?
  changeKind            String    @default("create")
  restoredFromVersionId String?
  publishedAt           DateTime?
  createdAt             DateTime  @default(now())

  document              DesignDocument       @relation("DesignDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  baseVersion           DesignVersion?       @relation("VersionLineage", fields: [baseVersionId], references: [id], onDelete: SetNull)
  descendants           DesignVersion[]      @relation("VersionLineage")
  restoredFromVersion   DesignVersion?       @relation("VersionRestore", fields: [restoredFromVersionId], references: [id], onDelete: SetNull)
  restoredByVersions    DesignVersion[]      @relation("VersionRestore")
  currentForDocuments   DesignDocument[]     @relation("DesignDocumentCurrentVersion")
  draftVersions         DesignDraftVersion[]
  candidateVersions     CandidateVersion[]
  dependenciesAsSource  DesignDependency[]   @relation("DependencySourceVersion")
  dependenciesAsTarget  DesignDependency[]   @relation("DependencyTargetVersion")
  changeSetItems        ChangeSetItem[]
  referenceSnapshots    ReferenceSnapshot[]
  validationRuns        ValidationRun[]
  previewSnapshots      PreviewSnapshot[]
  previewSnapshotJobs   PreviewSnapshotJob[]
  files                 DesignAssetFile[]
  draftsUsingAsBase     DesignDraft[]        @relation("DraftBaseVersion")
  candidatesUsingAsBase CandidateProposal[]  @relation("CandidateBaseVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId, publishedAt])
  @@index([baseVersionId])
  @@map("design_versions")
}

model DesignAssetFile {
  id        String   @id @default(uuid())
  versionId String
  path      String
  target    String?
  type      String   // registry:ui | registry:block | registry:file | asset:preview | asset:fixture | asset:doc
  language  String   // tsx | css | json | md
  content   String
  createdAt DateTime @default(now())

  version DesignVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, path])
  @@index([versionId])
  @@map("design_asset_files")
}

model DesignAssetTag {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  links DesignAssetTagLink[]

  @@map("design_asset_tags")
}

model DesignAssetTagLink {
  documentId String
  tagId      String

  document DesignDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      DesignAssetTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
  @@map("design_asset_tag_links")
}

model PreviewSnapshotJob {
  id           String    @id @default(uuid())
  versionId    String
  viewport     String    @default("desktop")
  state        String    @default("default")
  kind         String    @default("full")
  status       String    @default("pending") // pending | running | succeeded | failed
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  availableAt  DateTime  @default(now())
  leaseUntil   DateTime?
  workerId     String?
  error        String?
  artifactHash String?
  storagePath  String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  version DesignVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, viewport, state, kind])
  @@index([status, availableAt])
  @@index([versionId])
  @@map("preview_snapshot_jobs")
}

model DesignDependency {
  id             String   @id @default(uuid())
  fromDocumentId String
  fromVersionId  String
  toDocumentId   String
  toVersionId    String
  dependencyType String   @default("uses")
  createdAt      DateTime @default(now())

  fromDocument DesignDocument @relation("DependencyFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  fromVersion  DesignVersion  @relation("DependencySourceVersion", fields: [fromVersionId], references: [id], onDelete: Cascade)
  toDocument   DesignDocument @relation("DependencyTo", fields: [toDocumentId], references: [id], onDelete: Cascade)
  toVersion    DesignVersion  @relation("DependencyTargetVersion", fields: [toVersionId], references: [id], onDelete: Cascade)

  @@unique([fromVersionId, toVersionId, dependencyType])
  @@index([fromDocumentId])
  @@index([toDocumentId])
  @@map("design_dependencies")
}

model ChangeSession {
  id              String   @id @default(uuid())
  request         String
  status          String   @default("open")
  providerId      String?
  documentId      String?
  title           String?
  model           String?
  contextSnapshot String?
  budget          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider           AiProvider?         @relation("ChangeSessionProvider", fields: [providerId], references: [id], onDelete: SetNull)
  document           DesignDocument?     @relation("DesignStudioSessions", fields: [documentId], references: [id], onDelete: SetNull)
  drafts             DesignDraft[]
  messages           StudioMessage[]
  referenceSnapshots ReferenceSnapshot[]
  tasks              DesignTask[]

  @@index([status, createdAt])
  @@index([providerId])
  @@map("design_change_sessions")
}

model DesignDraft {
  id            String    @id @default(uuid())
  sessionId     String?
  documentId    String
  baseVersionId String
  draftRevision Int       @default(1)
  status        String    @default("editing")
  lockVersion   Int       @default(1)
  candidateSlotsUsed Int  @default(0)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  session              ChangeSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  document             DesignDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  baseVersion          DesignVersion        @relation("DraftBaseVersion", fields: [baseVersionId], references: [id], onDelete: Restrict)
  versions             DesignDraftVersion[]
  candidates           CandidateProposal[]
  files                DesignDraftFile[]
  snapshots            DesignDraftSnapshot[]
  changeSet            ChangeSet?
  changeSetMemberships ChangeSetDraft[]

  @@index([documentId, status])
  @@index([baseVersionId])
  @@index([sessionId])
  @@map("design_drafts")
}

model DesignDraftFile {
  id        String   @id @default(uuid())
  draftId   String
  path      String
  target    String?
  type      String
  language  String
  content   String
  updatedAt DateTime @updatedAt

  draft DesignDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, path])
  @@index([draftId])
  @@map("design_draft_files")
}

model DesignDraftSnapshot {
  id        String   @id @default(uuid())
  draftId   String
  revision  Int
  manifest  String
  files     String
  createdAt DateTime @default(now())

  draft DesignDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, revision])
  @@index([draftId, revision])
  @@map("design_draft_snapshots")
}

model StudioMessage {
  id          String   @id @default(uuid())
  sessionId   String
  role        String   // user | assistant | system
  content     String
  candidateId String?
  status      String   @default("sent")
  createdAt   DateTime @default(now())

  session ChangeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("design_studio_messages")
}

model DesignDraftVersion {
  id        String   @id @default(uuid())
  draftId   String
  versionId String
  createdAt DateTime @default(now())

  draft   DesignDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  version DesignVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([draftId, versionId])
  @@map("design_draft_versions")
}

model CandidateProposal {
  id             String   @id @default(uuid())
  draftId        String
  baseVersionId  String
  label          String
  rationale      String?
  patch          String
  structuredDiff String?
  impactReport   String?
  status         String   @default("planned")
  generationKey  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  draft            DesignDraft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  baseVersion      DesignVersion      @relation("CandidateBaseVersion", fields: [baseVersionId], references: [id], onDelete: Restrict)
  versions         CandidateVersion[]
  validationRuns   ValidationRun[]
  previewSnapshots PreviewSnapshot[]
  changeSetItems   ChangeSetItem[]    @relation("ChangeSetItemCandidate")
  tasks            DesignTask[]

  @@unique([draftId, generationKey])
  @@index([draftId, status])
  @@index([baseVersionId])
  @@map("design_candidate_proposals")
}

model CandidateVersion {
  id          String   @id @default(uuid())
  candidateId String
  versionId   String
  createdAt   DateTime @default(now())

  candidate CandidateProposal @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  version   DesignVersion     @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([candidateId, versionId])
  @@map("design_candidate_versions")
}

model ChangeSet {
  id                   String   @id @default(uuid())
  draftId              String   @unique
  status               String   @default("draft")
  publishTransactionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  draft  DesignDraft      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  items  ChangeSetItem[]
  drafts ChangeSetDraft[]

  @@index([status, createdAt])
  @@map("design_change_sets")
}

model ChangeSetDraft {
  id          String   @id @default(uuid())
  changeSetId String
  draftId     String
  createdAt   DateTime @default(now())

  changeSet ChangeSet   @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  draft     DesignDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([changeSetId, draftId])
  @@unique([draftId])
  @@index([draftId])
  @@map("design_change_set_drafts")
}

model ChangeSetItem {
  id            String  @id @default(uuid())
  changeSetId   String
  documentId    String
  baseVersionId String
  candidateId   String?
  selectedPatch String?
  status        String  @default("pending")

  changeSet   ChangeSet          @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  document    DesignDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  baseVersion DesignVersion      @relation(fields: [baseVersionId], references: [id], onDelete: Restrict)
  candidate   CandidateProposal? @relation("ChangeSetItemCandidate", fields: [candidateId], references: [id], onDelete: SetNull)

  @@unique([changeSetId, documentId])
  @@index([documentId, status])
  @@map("design_change_set_items")
}

model ReferenceSnapshot {
  id               String    @id @default(uuid())
  sessionId        String?
  versionId        String?
  sourceResourceId String?
  sourceUrl        String?
  contentHash      String
  capturedAt       DateTime  @default(now())
  policy           String    @default("inspiration_only")
  snapshotVersion  String    @default("1")
  retentionUntil   DateTime?
  metadata         String?

  session        ChangeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  version        DesignVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  sourceResource Resource?      @relation("ReferenceSnapshotResource", fields: [sourceResourceId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([versionId])
  @@index([sourceResourceId])
  @@index([contentHash])
  @@map("design_reference_snapshots")
}

model ValidationRun {
  id            String    @id @default(uuid())
  candidateId   String?
  versionId     String?
  status        String    @default("pending")
  policyVersion String
  result        String?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  candidate CandidateProposal? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  version   DesignVersion?     @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([candidateId, status])
  @@index([versionId, status])
  @@map("design_validation_runs")
}

model PreviewSnapshot {
  id             String   @id @default(uuid())
  candidateId    String?
  versionId      String?
  viewport       String
  state          String   @default("default")
  kind           String   @default("full")
  format         String   @default("png")
  width          Int?
  height         Int?
  browser        String
  fixtureVersion String
  artifactHash   String
  storagePath    String?
  createdAt      DateTime @default(now())

  candidate CandidateProposal? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  version   DesignVersion?     @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([candidateId, viewport])
  @@index([versionId, viewport])
  @@unique([versionId, viewport, state, kind])
  @@map("design_preview_snapshots")
}

model DesignTask {
  id             String    @id @default(uuid())
  sessionId      String?
  candidateId    String?
  taskType       String
  status         String    @default("pending")
  input          String?
  result         String?
  idempotencyKey String?
  retryCount     Int       @default(0)
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime?
  leaseToken     String?
  leaseExpiresAt DateTime?
  candidateSlotsReleasedAt DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  session   ChangeSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  candidate CandidateProposal? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, taskType, idempotencyKey])
  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("design_tasks")
}

model DesignAccessLog {
  id             String   @id @default(uuid())
  documentId     String?
  endpoint       String
  accessType     String
  keyFingerprint String?
  clientId       String?
  createdAt      DateTime @default(now())

  document DesignDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([accessType, createdAt])
  @@map("design_access_logs")
}

/// Immutable acknowledgement of the exact terms revision used by a reference source.
model DesignReferenceTermsAcceptance {
  id           String   @id @default(uuid())
  sourceId     String
  termsUrl     String
  termsVersion String
  termsHash    String
  acceptedBy   String
  acceptedAt   DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, termsUrl, termsHash])
  @@index([sourceId, acceptedAt])
  @@map("design_reference_terms_acceptances")
}

/// One row per source makes the per-minute reference reservation atomic across workers.
model DesignReferenceQuota {
  sourceId      String   @id
  windowStartedAt DateTime
  count         Int      @default(0)
  updatedAt     DateTime @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("design_reference_quotas")
}
