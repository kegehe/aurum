{
  "name": "@aurum/api",
  "version": "0.1.0",
  "main": "dist/app.module.js",
  "types": "dist/app.module.d.ts",
  "private": true,
  "description": "Aurum 后端 API（NestJS）",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma": "prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^5.22.0",
    "archiver": "^8.0.0",
    "cheerio": "1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "ipaddr.js": "2.2.0",
    "joi": "^17.13.3",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "1.1.1",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "undici": "6.21.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@playwright/test": "1.51.1",
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "^5.22.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
