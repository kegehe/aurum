{
  "name": "aurum",
  "version": "0.1.0",
  "private": true,
  "description": "Aurum - 多类型资源管理平台 (TypeScript 全栈模块化单体)",
  "scripts": {
    "clean:ports": "node scripts/clean-dev-ports.mjs 3000 3001",
    "dev:api": "node scripts/clean-dev-ports.mjs 3000 && pnpm --filter @aurum/api start:dev",
    "dev:web": "node scripts/clean-dev-ports.mjs 3001 && pnpm --filter @aurum/web dev",
    "dev:worker": "pnpm --filter @aurum/worker start:dev",
    "dev": "pnpm clean:ports && concurrently -n api,web -c blue,green \"pnpm --filter @aurum/api start:dev\" \"pnpm --filter @aurum/web dev\"",
    "build:api": "pnpm --filter @aurum/api build",
    "build:worker": "pnpm --filter @aurum/worker build",
    "build:web": "pnpm --filter @aurum/web build",
    "start:api": "pnpm --filter @aurum/api start:prod",
    "start:web": "pnpm --filter @aurum/web start",
    "start:worker": "pnpm --filter @aurum/worker start",
    "lint": "pnpm -r lint",
    "lint:check": "pnpm -r lint:check",
    "sync:enums": "node scripts/sync-shared-enums.mjs",
    "check:enums": "node scripts/sync-shared-enums.mjs --check",
    "depcruise": "depcruise apps/api/src",
    "depcruise:graph": "depcruise apps/api/src --output-type mermaid",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @aurum/api prisma migrate dev",
    "db:seed": "pnpm --filter @aurum/api prisma db seed",
    "db:studio": "pnpm --filter @aurum/api prisma studio",
    "db:generate": "pnpm --filter @aurum/api prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.1.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.10.0"
}
