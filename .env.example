# 应用
NODE_ENV=development
PORT=3000

# 数据库（SQLite 开发阶段；切 PostgreSQL 时改为 postgresql://...）
DATABASE_URL="file:./prisma/dev.db"

# 文件存储
STORAGE_DRIVER=local
STORAGE_ROOT=../../storage

# 上传限制
MAX_UPLOAD_SIZE_MB=1024
MAX_UPLOAD_TOTAL_SIZE_MB=5120
TEMP_FILE_TTL_SECONDS=3600

# Worker（阶段 6 异步处理）
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_RETRY=3
WORKER_CONCURRENCY=2

# 外部链接导入 Worker
INGESTION_POLL_INTERVAL_MS=3000
INGESTION_STALE_JOB_TIMEOUT_MS=60000

# 缩略图
THUMBNAIL_MAX_WIDTH=400
THUMBNAIL_MAX_HEIGHT=400

# 以下为阶段 6+ 配置，阶段 1-5 不需要
# REDIS_URL=redis://localhost:6379
# FFMPEG_PATH=
