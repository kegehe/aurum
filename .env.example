# 应用
NODE_ENV=development
PORT=3000

# 数据库（SQLite 开发阶段；切 PostgreSQL 时改为 postgresql://...）
DATABASE_URL="file:./prisma/dev.db"

# 文件存储
STORAGE_DRIVER=local
STORAGE_ROOT=../../storage

# 上传限制
MAX_UPLOAD_SIZE_MB=1024
MAX_UPLOAD_TOTAL_SIZE_MB=5120
TEMP_FILE_TTL_SECONDS=3600

# Worker（阶段 6 异步处理）
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_RETRY=3
WORKER_CONCURRENCY=2

# 外部链接导入 Worker
INGESTION_POLL_INTERVAL_MS=3000
INGESTION_STALE_JOB_TIMEOUT_MS=60000

# 链接健康检查调度（P4）
INGESTION_HEALTH_CHECK_INTERVAL_MS=21600000
INGESTION_HEALTH_CHECK_BATCH_SIZE=10

# 来源定时自动同步调度（每 N 毫秒扫描一次到期来源，interval 在来源配置中设置）
INGESTION_AUTO_SYNC_CHECK_INTERVAL_MS=60000
INGESTION_AUTO_SYNC_BATCH_SIZE=10

# 出站 HTTP 代理（可选）—— 本机经本地代理（Clash/V2Ray 等）访问外网时必须配置，
# 否则后端 fetch 不走系统代理，外部同步（如 Civitai）会报 "fetch failed"。
# 直连网络留空即可。
# HTTP_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10808
# NO_PROXY=localhost,127.0.0.1

# 缩略图
THUMBNAIL_MAX_WIDTH=400
THUMBNAIL_MAX_HEIGHT=400

# 样式实验室（AI）—— 不配置时该功能禁用
# 提示：也可以不改 .env，在「设置 → AI 配置」页面运行时添加/切换 API Key，立即生效
# Anthropic API Key，从 https://console.anthropic.com 获取
ANTHROPIC_API_KEY=
# 自定义接口地址（可选，留空用官方 https://api.anthropic.com）。SDK 会自动追加 /v1/messages
ANTHROPIC_BASE_URL=
# 样式分析模型（默认 claude-sonnet-5）
AI_STYLE_MODEL=claude-sonnet-5
# 单张分析图片上限（MB）
MAX_STYLE_IMAGE_SIZE_MB=20

# 已发布设计资产/MCP 只读访问密钥。生产环境必须配置，至少 16 位。
# DESIGN_READ_API_KEY=
# 编辑/草稿/预览接口的内部服务密钥。生产环境必须配置，并仅由认证网关注入。
# DESIGN_INTERNAL_API_KEY=

# GitHub API Token（可选）—— github 来源同步使用，提高速率限额（5000 次/小时）并支持私有仓库。
# 在 https://github.com/settings/tokens 创建只读 fine-grained token；留空则匿名访问。
# GITHUB_TOKEN=

# 以下为阶段 6+ 配置，阶段 1-5 不需要
# REDIS_URL=redis://localhost:6379
# FFMPEG_PATH=
