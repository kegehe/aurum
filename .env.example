# 应用
NODE_ENV=development
PORT=3000

# 数据库（SQLite 开发阶段；切 PostgreSQL 时改为 postgresql://...）
# 注意：SQLite 的 file: 相对 prisma/schema.prisma 所在目录解析。
# 写 ./prisma/dev.db 实际落盘在 apps/api/prisma/prisma/dev.db；想让库待在 prisma/ 下应写 file:./dev.db。
DATABASE_URL="file:./prisma/dev.db"

# 文件存储
STORAGE_DRIVER=local
STORAGE_ROOT=../../storage

# 上传限制
MAX_UPLOAD_SIZE_MB=1024
MAX_UPLOAD_TOTAL_SIZE_MB=5120
TEMP_FILE_TTL_SECONDS=3600

# 处理任务
# PDF 文本提取上限（MB）：pdf-parse 需把整份文件读进内存，超过该体积跳过解析（不写 searchVector）。
# 单任务峰值内存约为该值的 1.5 倍（非 ASCII 长文本更高），按 WORKER_CONCURRENCY 叠加。
MAX_PDF_PARSE_SIZE_MB=100

# 进程分工（默认全开 = 单进程跑全部；拆独立 Worker 时按进程关闭其一）
# API 进程设 EXECUTION_ENABLED=false → 只入队处理任务，不认领
# Worker 进程默认 INGESTION_ENABLED=false → 只跑处理任务，摄入调度留在 API
# EXECUTION_ENABLED=true
# INGESTION_ENABLED=true

# Worker（阶段 6 异步处理）
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_RETRY=3
WORKER_CONCURRENCY=2
# 超过该时长没有心跳仍停在「处理中」的任务视为卡死，自动重新排队（默认 5 分钟）
WORKER_STALE_JOB_TIMEOUT_MS=300000
# 兜底：处理器卡住但进程仍能发心跳时，单次执行超过该时长也会被强制回收（默认 30 分钟）
WORKER_MAX_EXECUTION_MS=1800000

# 外部链接导入 Worker
INGESTION_POLL_INTERVAL_MS=3000
INGESTION_STALE_JOB_TIMEOUT_MS=60000

# 链接健康检查调度（P4）
INGESTION_HEALTH_CHECK_INTERVAL_MS=21600000
INGESTION_HEALTH_CHECK_BATCH_SIZE=10

# 来源定时自动同步调度（每 N 毫秒扫描一次到期来源，interval 在来源配置中设置）
INGESTION_AUTO_SYNC_CHECK_INTERVAL_MS=60000
INGESTION_AUTO_SYNC_BATCH_SIZE=10

# 失败下载的自动补漏（指数退避 30m→1h→2h→4h，最多 5 次后转为手动重试）
INGESTION_RETRY_SWEEP_INTERVAL_MS=60000
INGESTION_RETRY_SWEEP_BATCH_SIZE=20

# 出站 HTTP 代理（可选）—— 本机经本地代理（Clash/V2Ray 等）访问外网时必须配置，
# 否则后端 fetch 不走系统代理，外部同步（如 Civitai）会报 "fetch failed"。
# 直连网络留空即可。
# HTTP_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10808
# NO_PROXY=localhost,127.0.0.1

# 出站 DNS 解析（SSRF 校验用）：auto = 配置代理时走 DoH，避免本地 DNS 污染；
# doh = 强制 DoH；system = 只用系统 DNS。DoH 查询同样经上面的代理发出。
SAFE_URL_DNS_MODE=auto
SAFE_URL_DOH_URL=https://cloudflare-dns.com/dns-query
SAFE_URL_DOH_TIMEOUT_MS=3000

# 缩略图
THUMBNAIL_MAX_WIDTH=400
THUMBNAIL_MAX_HEIGHT=400

# 样式实验室（AI）—— 不配置时该功能禁用
# 提示：也可以不改 .env，在「设置 → AI 配置」页面运行时添加/切换 API Key，立即生效
# Anthropic API Key，从 https://console.anthropic.com 获取
ANTHROPIC_API_KEY=
# 自定义接口地址（可选，留空用官方 https://api.anthropic.com）。SDK 会自动追加 /v1/messages
ANTHROPIC_BASE_URL=
# 样式分析模型（默认 claude-sonnet-5）
AI_STYLE_MODEL=claude-sonnet-5
# 单张分析图片上限（MB）
MAX_STYLE_IMAGE_SIZE_MB=20

# 已发布设计资产/MCP 只读访问密钥。生产环境必须配置，至少 16 位。
# DESIGN_READ_API_KEY=
# 编辑/草稿/预览接口的内部服务密钥。生产环境必须配置，并仅由认证网关注入。
# DESIGN_INTERNAL_API_KEY=

# GitHub API Token（可选）—— github 来源同步使用，提高速率限额（5000 次/小时）并支持私有仓库。
# 在 https://github.com/settings/tokens 创建只读 fine-grained token；留空则匿名访问。
# GITHUB_TOKEN=

# 以下为阶段 6+ 配置，阶段 1-5 不需要
# REDIS_URL=redis://localhost:6379
# FFMPEG_PATH=
